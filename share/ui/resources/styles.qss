QComboBox {
    /* padding: 0; */
    /* margin: 0; */
    /* margin-right: 0; */
}

#ColorEntry {
    /* background-color: aquamarine; */
    max-height: 22px;
    padding: 0;
}

.active-frame {
    background-color: palette(base);
    border: 1px solid palette(midlight);
}

.normal-background {
    background-color: palette(window);
}

.active-background {
    background-color: palette(base);
    /* color: palette(highlighted-text); */
}

.resizing-separator {
    background: palette(mid);
}

Linea--UI--SimpleGrid {
    background-color: palette(base);
    border: 1px solid palette(midlight);
    padding: 1px;
}

Linea--UI--SimpleGrid[frame="false"] {
    border: none;
}

Linea--UI--SimpleGrid[class="normal-background"] {
    background-color: palette(window);
}

Linea--UI--SimpleGrid[class="normal-background"] > QScrollArea {
    background-color: palette(window);
}

Linea--UI--SimpleGrid > QScrollArea {
    background-color: palette(base);
}

Linea--UI--VirtualTreeList {
    background-color: palette(base);
    border: 1px solid palette(midlight);
    padding: 1px;
}

Linea--UI--VirtualTreeList[frame="false"] {
    border: none;
}

Linea--UI--VirtualTreeList[active-bgnd="false"] {
    background-color: palette(window);
}

/* QTreeView header styling - scoped to specific class */
QTreeView[class="styled-header"]::header {
    background-color: palette(window);
    border: none;
    border-bottom: 1px solid palette(midlight);
}

QTreeView[class="styled-header"] QHeaderView::section {
    background-color: palette(window);
    color: palette(dark);
    padding: 0px 4px;
    border: none;
    border-right: 1px solid palette(midlight);
    border-bottom: 1px solid palette(midlight);
    font-weight: 500;
    text-transform: uppercase;
    text-align: left;
}

/* QTreeView[class="styled-header"] QHeaderView::section:first {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

QTreeView[class="styled-header"] QHeaderView::section:last {
    border-right: none;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
} */

QTreeView[class="styled-header"] QHeaderView::section:hover {
    background-color: palette(midlight);
}

QTreeView[class="styled-header"] QHeaderView::section:pressed {
    background-color: palette(mid);
}

/* Switch toggle widget */
Linea--UI--SwitchWidget {
    min-width: 34px;
    min-height: 18px;
    max-height: 18px;
}

Linea--UI--FontSelector {
    background-color: palette(base);
    border: 1px solid palette(midlight);
    border-radius: 4px;
}

QPushButton#SelectorButton {
    border-radius: 3px;
    border-bottom-left-radius: 0;
    border-top-left-radius: 0;
    min-width: 22px;
    min-height: 22px;
}

/* Linea--UI--GuideWidget {
    background-color: red;
    padding: 0;
    margin: 0;
} */

/* Chrome button — accent color with a pressed shade */
QToolButton[class="attention-button"] {
    background-color: palette(highlight);
}

QToolButton[class="attention-button"]:pressed {
    background-color: palette(accent);
}

/* Thin horizontal separator line. `color` sets the line colour (use any
   palette role for theme-awareness); `qproperty-opacity` controls alpha. */
Linea--UI--Separator {
    color: palette(mid);
    qproperty-opacity: 1.0;
}

/* Panel switch — horizontal strip of exclusive push buttons for switching
   between panels. Active button uses a distinct background via :checked. */
Linea--UI--PanelSwitch QPushButton {
    min-width: 40px;
    background-color: palette(window);
}
/* Linea--UI--PanelSwitch QPushButton[iconOnly="true"] {
    min-width: 22px;
} */
Linea--UI--PanelSwitch QPushButton:checked {
    background-color: palette(button);
}

QListView#symbols-view {
    font-size: 10px;
}
