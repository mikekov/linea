# SPDX-License-Identifier: GPL-2.0-or-later
# EditorConfig for this workspace
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

[*.{ui,xml}]
indent_size = 2
tab_width = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,makefile,*.mk}]
indent_style = tab
