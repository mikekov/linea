                  <property name="class" stdset="0">
                    <string>panel-label</string>
                  </property>
                  <property name="toolTip">
                    <string>Favors connections that are part of a long curve (multiplier)</string>
                  </property>
                </widget>
              </item>
              <!-- Curves SpinScale -->
              <item row="2" column="0">
                <widget class="Linea::UI::SpinScale" name="PA_curves" native="true">
                  <property name="minimum">
                    <double>-10.000000000000000</double>
                  </property>
                  <property name="maximum">
                    <double>10.000000000000000</double>
                  </property>
                  <property name="decimals">
                    <number>3</number>
                  </property>
                  <property name="singleStep">
                    <double>0.200000000000000</double>
                  </property>
                  <property name="toolTip">
                    <string>The heuristic computed vote will be multiplied by this value</string>
                  </property>
                </widget>
              </item>

              <!-- Islands label -->
              <item row="3" column="0">
                <widget class="QLabel" name="paIslandsLabel">
                  <property name="text">
                    <string>Islands</string>
                  </property>
                  <property name="class" stdset="0">
                    <string>panel-label</string>
                  </property>
                  <property name="toolTip">
                    <string>Avoid single disconnected pixels (weight)</string>
                  </property>
                </widget>
              </item>
              <!-- Islands SpinScale -->
              <item row="4" column="0">
                <widget class="Linea::UI::SpinScale" name="PA_islands" native="true">
                  <property name="minimum">
                    <double>-20.000000000000000</double>
                  </property>
                  <property name="maximum">
                    <double>20.000000000000000</double>
                  </property>
                  <property name="decimals">
                    <number>0</number>
                  </property>
                  <property name="singleStep">
                    <double>1.000000000000000</double>
                  </property>
                  <property name="toolTip">
                    <string>A constant vote value</string>
                  </property>
                </widget>
              </item>

              <!-- Sparse pixels label -->
              <item row="5" column="0">
                <widget class="QLabel" name="paSparseLabel">
                  <property name="text">
                    <string>Sparse pixels</string>
                  </property>
                  <property name="class" stdset="0">
                    <string>panel-heading</string>
                  </property>
                  <property name="toolTip">
                    <string>Favors connections that are part of foreground color</string>
                  </property>
                </widget>
              </item>

              <!-- Window radius label -->
              <item row="6" column="0">
                <widget class="QLabel" name="paRadiusLabel">
                  <property name="text">
                    <string>Window radius</string>
                  </property>
                  <property name="class" stdset="0">
                    <string>panel-label</string>
                  </property>
                </widget>
              </item>
              <!-- Window radius SpinScale -->
              <item row="7" column="0">
                <widget class="Linea::UI::SpinScale" name="PA_sparse1" native="true">
                  <property name="minimum">
                    <double>2.000000000000000</double>
                  </property>
                  <property name="maximum">
                    <double>8.000000000000000</double>
                  </property>
                  <property name="decimals">
                    <number>0</number>
                  </property>
                  <property name="singleStep">
                    <double>1.000000000000000</double>
                  </property>
                  <property name="toolTip">
                    <string>The radius of the window analyzed</string>
                  </property>
                </widget>
              </item>

              <!-- Multiplier label -->
              <item row="8" column="0">
                <widget class="QLabel" name="paMultiplierLabel">
                  <property name="text">
                    <string>Multiplier</string>
                  </property>
                  <property name="class" stdset="0">
                    <string>panel-label</string>
                  </property>
                </widget>
              </item>
              <!-- Multiplier SpinScale -->
              <item row="9" column="0">
                <widget class="Linea::UI::SpinScale" name="PA_sparse2" native="true">
                  <property name="minimum">
                    <double>-10.000000000000000</double>
                  </property>
                  <property name="maximum">
                    <double>10.000000000000000</double>
                  </property>
                  <property name="decimals">
                    <number>3</number>
                  </property>
                  <property name="singleStep">
                    <double>0.200000000000000</double>
                  </property>
                  <property name="toolTip">
                    <string>The heuristic computed vote will be multiplied by this value</string>
                  </property>
                </widget>
              </item>

              <!-- Optimize -->
              <item row="10" column="0">
                <widget class="QCheckBox" name="CB_PA_optimize">
                  <property name="text">
                    <string>Optimize</string>
                  </property>
                  <property name="toolTip">
                    <string>Try to optimize paths by joining adjacent Bezier curve segments</string>
                  </property>
                </widget>
              </item>

              <!-- Output label -->
              <item row="11" column="0">
                <widget class="QLabel" name="paOutputLabel">
                  <property name="text">
                    <string>Output</string>
                  </property>
                  <property name="class" stdset="0">
                    <string>panel-heading</string>
                  </property>
                </widget>
              </item>

              <!-- Voronoi radio -->
              <item row="12" column="0">
                <widget class="QRadioButton" name="RB_PA_voronoi">
                  <property name="text">
                    <string>Voronoi</string>
                  </property>
                  <property name="toolTip">
                    <string>Output composed of straight lines</string>
                  </property>
                  <property name="checked">
                    <bool>true</bool>
                  </property>
                </widget>
              </item>

              <!-- B-splines radio -->
              <item row="13" column="0">
                <widget class="QRadioButton" name="RB_PA_bsplines">
                  <property name="text">
                    <string>B-splines</string>
                  </property>
                  <property name="toolTip">
                    <string>Preserve staircasing artifacts</string>
                  </property>
                </widget>
              </item>

              <!-- Bottom stretch keeps content anchored to the top -->
              <item row="14" column="0">
                <spacer name="pixelArtBottomStretch">
                  <property name="orientation">
                    <enum>Qt::Vertical</enum>
                  </property>
                  <property name="sizeHint" stdset="0">
                    <size>
                      <width>0</width>
                      <height>0</height>
                    </size>
                  </property>
                </spacer>
              </item>

            </layout>
          </widget>

        </widget>
      </item>

      <!-- ============================================================ -->
      <!-- Preview area                                                 -->
      <!-- ============================================================ -->
      <item>
        <widget class="QLabel" name="previewLabel">
          <property name="text">
            <string>Preview</string>
          </property>
          <property name="class" stdset="0">
            <string>panel-label</string>
          </property>
        </widget>
      </item>
      <item>
        <widget class="QLabel" name="previewArea">
          <property name="minimumSize">
            <size>
              <width>100</width>
              <height>100</height>
            </size>
          </property>
          <property name="alignment">
            <set>Qt::AlignCenter</set>
          </property>
          <property name="text">
            <string/>
          </property>
          <property name="class" stdset="0">
            <string>placeholder-label</string>
          </property>
        </widget>
      </item>
      <item>
        <layout class="QHBoxLayout" name="previewButtonLayout">
          <property name="spacing">
            <number>4</number>
          </property>
          <item>
            <widget class="QCheckBox" name="livePreview">
              <property name="text">
                <string>Live updates</string>
              </property>
              <property name="checked">
                <bool>true</bool>
              </property>
            </widget>
          </item>
          <item>
            <spacer>
              <property name="orientation">
                <enum>Qt::Horizontal</enum>
              </property>
            </spacer>
          </item>
          <item>
            <widget class="QPushButton" name="updatePreviewButton">
              <property name="text">
                <string>Update preview</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- ============================================================ -->
      <!-- Bottom bar: Apply/Reset  or  Abort/Progress                  -->
      <!-- ============================================================ -->
      <item>
        <widget class="QStackedWidget" name="actionStack">
          <property name="sizePolicy">
            <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
            </sizepolicy>
          </property>

          <!-- Page 1: Apply + Reset -->
          <widget class="QWidget" name="actionIdle">
            <layout class="QHBoxLayout" name="actionIdleLayout">
              <property name="spacing">
                <number>4</number>
              </property>
              <property name="leftMargin">
                <number>0</number>
              </property>
              <property name="topMargin">
                <number>0</number>
              </property>
              <property name="rightMargin">
                <number>0</number>
              </property>
              <property name="bottomMargin">
                <number>0</number>
              </property>
              <item>
                <widget class="QPushButton" name="resetButton">
                  <property name="sizePolicy">
                    <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                      <horstretch>0</horstretch>
                      <verstretch>0</verstretch>
                    </sizepolicy>
                  </property>
                  <property name="toolTip">
                    <string>Reset to defaults</string>
                  </property>
                  <property name="icon">
                    <iconset>
                      <normaloff>:/icons/reset-to-defaults</normaloff>
                    </iconset>
                  </property>
                </widget>
              </item>
              <item>
                <widget class="QPushButton" name="applyButton">
                  <property name="text">
                    <string>Apply</string>
                  </property>
                </widget>
              </item>
            </layout>
          </widget>

          <!-- Page 2: Abort + Progress -->
          <widget class="QWidget" name="actionBusy">
            <layout class="QHBoxLayout" name="actionBusyLayout">
              <property name="spacing">
                <number>4</number>
              </property>
              <property name="leftMargin">
                <number>0</number>
              </property>
              <property name="topMargin">
                <number>0</number>
              </property>
              <property name="rightMargin">
                <number>0</number>
              </property>
              <property name="bottomMargin">
                <number>0</number>
              </property>
              <item>
                <widget class="QPushButton" name="abortButton">
                  <property name="toolTip">
                    <string>Abort trace operation</string>
                  </property>
                  <property name="icon">
                    <iconset>
                      <normaloff>:/icons/process-stop</normaloff>
                    </iconset>
                  </property>
                </widget>
              </item>
              <item>
                <widget class="QProgressBar" name="progressBar">
                  <property name="value">
                    <number>0</number>
                  </property>
                </widget>
              </item>
            </layout>
          </widget>

        </widget>
      </item>

    </layout>
  </widget>

  <customwidgets>
    <customwidget>
      <class>Linea::UI::TabStrip</class>
      <extends>QWidget</extends>
      <header>tab-strip.h</header>
    </customwidget>
    <customwidget>
      <class>Linea::UI::SpinScale</class>
      <extends>QWidget</extends>
      <header>spin-scale.h</header>
    </customwidget>
    <customwidget>
      <class>Linea::UI::SwitchWidget</class>
      <extends>QAbstractButton</extends>
      <header>switch-widget.h</header>
    </customwidget>
  </customwidgets>
  <resources/>
  <connections/>
</ui>
