                    <height>10</height>
                  </size>
                </property>
              </spacer>
            </item>

            <!-- Row 11: Rendering label -->
            <item row="11" column="0" colspan="3">
              <widget class="QLabel" name="renderingOptionsLabel">
                <property name="text">
                  <string>Rendering</string>
                </property>
                <property name="class" stdset="0">
                  <string>panel-heading</string>
                </property>
              </widget>
            </item>

            <!-- Rows 12–13: Rendering checkboxes in a vertical box -->
            <item row="12" column="0" colspan="3">
              <layout class="QVBoxLayout" name="renderingOptionsLayout">
                <property name="spacing">
                  <number>10</number>
                </property>
                <property name="leftMargin">
                  <number>4</number>
                </property>
                <property name="topMargin">
                  <number>0</number>
                </property>
                <property name="rightMargin">
                  <number>0</number>
                </property>
                <property name="bottomMargin">
                  <number>0</number>
                </property>
                <item>
                  <widget class="QCheckBox" name="antialiasCheck">
                    <property name="text">
                      <string>Anti-alias</string>
                    </property>
                  </widget>
                </item>
                <item>
                  <widget class="QCheckBox" name="clipToPageCheck">
                    <property name="text">
                      <string>Clip to page</string>
                    </property>
                  </widget>
                </item>
              </layout>
            </item>

            <!-- Bottom stretch -->
            <item row="20" column="0" colspan="3">
              <spacer>
                <property name="orientation">
                  <enum>Qt::Vertical</enum>
                </property>
              </spacer>
            </item>

          </layout>
        </widget>
      </item>

    </layout>
  </widget>

  <customwidgets>
    <customwidget>
      <class>Linea::UI::NumberEdit</class>
      <extends>QWidget</extends>
      <header>number-edit.h</header>
    </customwidget>
    <customwidget>
      <class>Linea::UI::ColorPicker</class>
      <extends>QWidget</extends>
      <header>qt/ui/color-picker.h</header>
    </customwidget>
  </customwidgets>

  <buttongroups>
    <buttongroup name="orientationGroup"/>
    <buttongroup name="yAxisGroup"/>
  </buttongroups>

  <resources/>
  <connections/>
</ui>
