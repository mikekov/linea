<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
  <class>ColorNotebook</class>
  <widget class="QWidget" name="ColorNotebook">
    <property name="geometry">
      <rect>
        <x>0</x>
        <y>0</y>
        <width>240</width>
        <height>300</height>
      </rect>
    </property>
    <layout class="QGridLayout" name="mainLayout" rowstretch="0,0,0,1">
      <property name="leftMargin">
        <number>0</number>
      </property>
      <property name="topMargin">
        <number>0</number>
      </property>
      <property name="rightMargin">
        <number>0</number>
      </property>
      <property name="bottomMargin">
        <number>0</number>
      </property>
      <property name="verticalSpacing">
        <number>0</number>
      </property>

      <!-- Row 0: header bar with label -->
      <item row="0" column="0">
        <widget class="QWidget" name="buttonBox" native="true">
          <property name="sizePolicy">
            <sizepolicy hsizetype="Preferred" vsizetype="Fixed"/>
          </property>
          <layout class="QHBoxLayout" name="buttonLayout" stretch="1">
            <property name="spacing">
              <number>4</number>
            </property>
            <property name="leftMargin">
              <number>2</number>
            </property>
            <property name="topMargin">
              <number>1</number>
            </property>
            <property name="rightMargin">
              <number>2</number>
            </property>
            <property name="bottomMargin">
              <number>1</number>
            </property>
            <item alignment="Qt::AlignVCenter">
              <widget class="QLabel" name="label">
                <property name="font">
                  <font>
                    <bold>true</bold>
                  </font>
                </property>
                <property name="alignment">
                  <set>Qt::AlignLeft|Qt::AlignVCenter</set>
                </property>
              </widget>
            </item>
          </layout>
        </widget>
      </item>

      <!-- Row 1: the ColorPage for the active space is inserted in code -->

      <item row="2" column="0">
        <spacer name="bottomSpacer">
          <property name="orientation">
            <enum>Qt::Orientation::Vertical</enum>
          </property>
          <property name="sizeType">
            <enum>QSizePolicy::Expanding</enum>
          </property>
          <property name="sizeHint" stdset="0">
            <size>
              <width>0</width>
              <height>4</height>
            </size>
          </property>
        </spacer>
      </item>

      <!-- Row 3: bottom bar with status icons, dropper, color entry,
           and space switcher (mirrors color-picker-panel.ui) -->
      <item row="3" column="0">
        <widget class="QWidget" name="colorEntryFrame" native="true">
          <property name="sizePolicy">
            <sizepolicy hsizetype="Preferred" vsizetype="Fixed"/>
          </property>
          <property name="class" stdset="0">
            <string>button-bar</string>
          </property>
          <layout class="QHBoxLayout" name="frameLayout" stretch="0,0,0,0,1,0,0">
            <property name="spacing">
              <number>4</number>
            </property>
            <property name="leftMargin">
              <number>4</number>
            </property>
            <property name="topMargin">
              <number>2</number>
            </property>
            <property name="rightMargin">
              <number>2</number>
            </property>
            <property name="bottomMargin">
              <number>1</number>
            </property>
            <item>
              <widget class="Linea::UI::IconWidget" name="colorManaged">
                <property name="toolTip">
                  <string>Color Managed</string>
                </property>
                <property name="enabled">
                  <bool>false</bool>
                </property>
                <property name="icon">
                  <iconset>
                    <normaloff>:/icons/color-management</normaloff>
                  </iconset>
                </property>
                <property name="iconSize">
                  <size>
                    <width>16</width>
                    <height>16</height>
                  </size>
                </property>
              </widget>
            </item>
            <item>
              <widget class="Linea::UI::IconWidget" name="tooMuchInk">
                <property name="toolTip">
                  <string>Too much ink!</string>
                </property>
                <property name="enabled">
                  <bool>false</bool>
                </property>
                <property name="icon">
                  <iconset>
                    <normaloff>:/icons/too-much-ink-icon</normaloff>
                  </iconset>
                </property>
                <property name="iconSize">
                  <size>
                    <width>16</width>
                    <height>16</height>
                  </size>
                </property>
              </widget>
            </item>
            <item>
              <widget class="QPushButton" name="btnPicker">
                <property name="toolTip">
                  <string>Pick colors from image</string>
                </property>
                <property name="icon">
                  <iconset>
                    <normaloff>:/icons/color-picker</normaloff>
                  </iconset>
                </property>
              </widget>
            </item>
            <item>
              <widget class="Linea::UI::ColorPreview" name="swatch">
                <property name="minimumSize">
                  <size>
                    <width>16</width>
                    <height>16</height>
                  </size>
                </property>
                <property name="maximumSize">
                  <size>
                    <width>16</width>
                    <height>16</height>
                  </size>
                </property>
              </widget>
            </item>
            <!-- hex color entry; ColorHolder is assigned in code -->
            <item>
              <widget class="Linea::UI::ColorEntry" name="rgbaEntry">
                <property name="sizePolicy">
                  <sizepolicy hsizetype="Expanding" vsizetype="Fixed"/>
                </property>
                <property name="frame">
                  <bool>false</bool>
                </property>
                <property name="class" stdset="0">
                  <string>button-bar</string>
                </property>
              </widget>
            </item>
            <!-- out-of-gamut warning icon -->
            <item>
              <widget class="Linea::UI::IconWidget" name="outOfGamut">
                <property name="visible">
                  <bool>false</bool>
                </property>
                <property name="toolTip">
                  <string>Out of gamut!</string>
                </property>
                <property name="icon">
                  <iconset>
                    <normaloff>:/icons/warning</normaloff>
                  </iconset>
                </property>
                <property name="iconSize">
                  <size>
                    <width>12</width>
                    <height>12</height>
                  </size>
                </property>
              </widget>
            </item>
            <!-- space switcher; hidden by default, callers can show it -->
            <item>
              <widget class="Linea::UI::IconComboBox" name="combo">
                <property name="focusPolicy">
                  <enum>Qt::NoFocus</enum>
                </property>
                <property name="toolTip">
                  <string>Choose style of color selection</string>
                </property>
                <property name="visible">
                  <bool>false</bool>
                </property>
              </widget>
            </item>
          </layout>
        </widget>
      </item>

      <!-- Row 4: absorbs any extra height; nothing above should stretch -->
      <item row="4" column="0">
        <spacer name="bottomSpacer2">
          <property name="orientation">
            <enum>Qt::Orientation::Vertical</enum>
          </property>
          <property name="sizeType">
            <enum>QSizePolicy::Expanding</enum>
          </property>
          <property name="sizeHint" stdset="0">
            <size>
              <width>0</width>
              <height>0</height>
            </size>
          </property>
        </spacer>
      </item>
    </layout>
  </widget>
  <customwidgets>
    <customwidget>
      <class>Linea::UI::IconComboBox</class>
      <extends>QPushButton</extends>
      <header>icon-combobox.h</header>
    </customwidget>
    <customwidget>
      <class>Linea::UI::ColorPreview</class>
      <extends>QWidget</extends>
      <header>color-preview.h</header>
    </customwidget>
    <customwidget>
      <class>Linea::UI::ColorEntry</class>
      <extends>QLineEdit</extends>
      <header>color-entry.h</header>
    </customwidget>
    <customwidget>
      <class>Linea::UI::IconWidget</class>
      <extends>QWidget</extends>
      <header>icon-widget.h</header>
    </customwidget>
  </customwidgets>
